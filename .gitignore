# ===== 敏感数据（绝不提交）=====
# 账号密码哈希 / 会话 token / 微信推送密钥 / 隧道凭证
data/users.json
data/sessions.json
data/stats.json
data/push-config.json
data/userdata/
.cf-home/

# ===== 本地运维脚本与二进制 =====
tools/
gp-terminal.tar.gz
cleanup-*.sh
recover-index-*.html
# 一次性迁移/验证脚本（跑完即删，不要进仓库历史）
scripts/_tmp-*

# ===== 日志（运行时产生，只留目录占位）=====
logs/*
!logs/.gitkeep
*.log

# ===== 运行时自动生成的行情快照（每天变化，不入库）=====
data/auction-*.json
data/us-sessions.json

# ===== 持仓审计与快照（v2.9.2，运行时数据，含账号与仓位）=====
data/portfolio-writes.jsonl
data/portfolio-history/
# 改数据前的手工备份（v2.10.7 起，含账号与仓位，绝不进仓库）
data/backups/

# ===== 环境与备份 =====
.dsh/
.dsh-project-memory/
.backup-*/
node_modules/
# 排查/验证用的临时目录（临时副本里会带 data/*.json 的拷贝，绝不能进仓库）
.probe/
*.probe/

# ===== 系统 =====
Thumbs.db
desktop.ini
.DS_Store

# Edge 无头截图用的临时浏览器 profile（体积大且无意义，绝不入库）
**/edge-profile/
