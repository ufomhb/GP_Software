{
  "name": "global-pulse-terminal",
  "version": "2.4.0",
  "private": true,
  "description": "寰球智投：A股、全球指数、期货、黄金白银实盘行情与板块资金流、规则化策略终端",
  "scripts": {
    "start": "node server.js --open",
    "serve": "node server.js",
    "test": "node --test test/*.test.mjs",
    "selfcheck": "node scripts/selfcheck-p0.mjs && node scripts/selfcheck-store.mjs",
    "migrate:sqlite": "node scripts/migrate-json-to-sqlite.mjs",
    "verify:sqlite": "node scripts/migrate-json-to-sqlite.mjs --verify",
    "backup:sqlite": "node scripts/backup-sqlite.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
